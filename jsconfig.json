{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "node",
    "checkJs": true,
    "allowJs": true,
    "maxNodeModuleJsDepth": 2,
    "baseUrl": "./",
    "paths": {
      "trss-yunzai": ["node_modules/@types/trss-yunzai/index.d.ts"]
    },
    "types": [
      "trss-yunzai"
    ]
  },
  "include": [
    "apps/**/*",
    "model/**/*",
    "logic/**/*",
    "handlers/**/*",
    "api/**/*",
    "index.js"
  ],
  "exclude": [
    "node_modules",
    "conductor",
    "resources",
    "logs",
    "data",
    "临时文件夹"
  ]
}
